# Optional. When this and VERCEL_OIDC_TOKEN are both unset, Lezgo runs in demo mode
# with sample readings so the app can be tried end to end.
AI_GATEWAY_API_KEY=

# Optional. Vision model id from https://ai-gateway.vercel.sh/v1/models
# The model must accept image input and structured output.
# Default: google/gemini-3.5-flash-lite
AI_GATEWAY_MODEL=google/gemini-3.5-flash-lite

# On Vercel, the platform sets VERCEL_OIDC_TOKEN for the deployment.
# Do not commit a real key. Local secrets belong in .env.local, which Next.js loads
# and git ignores.

# Room sync. Both are injected when you add the Upstash Redis integration
# from the Vercel Marketplace (Storage). Leave them empty to keep rooms
# in this server process only (fine for local play and tests, not for two phones
# on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Page photos for shared rooms. Injected when you add Vercel Blob
# from the dashboard (Storage → Blob). Leave empty to keep photos inside the
# room record. Add Blob before a room holds more than a couple of large pages.
BLOB_READ_WRITE_TOKEN=
